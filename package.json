{
  "name": "price-cap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:browser": "tsc -p tsconfig.browser.json",
    "test:browser": "vitest run --mode browser",
    "test:browser:build": "npm run build && npm run test:browser",
    "data:update": "node scripts/fetch-ofgem.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "decimal.js-light": "^2.5.1",
    "temporal-polyfill": "^1.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.10.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-istanbul": "^4.1.12",
    "axe-core": "^4.14.0",
    "fflate": "^0.8.2",
    "jsdom": "^26.0.0",
    "playwright": "1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  }
}
